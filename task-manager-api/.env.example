# Copie para .env e ajuste. Nenhum valor real deve ser versionado.
APP_ENV=development
# Obrigatória quando APP_ENV=production. Gere com: python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Default: sqlite em instance/tasks.db
DATABASE_URI=

# Notificações por e-mail (desligadas por padrão)
NOTIFICATIONS_ENABLED=false

# Autorização (RF-15). A imposição nasce LIGADA: rota sensível sem Bearer token
# responde 401 (obtenha o token em POST /login). Sensíveis: /users (menos POST),
# /users/<id>, /users/<id>/tasks, todo /tasks, /reports/* e a escrita em
# /categories. Abertas: /, /health, POST /users, GET /categories.
# Ponha `false` só para restaurar o contrato original durante uma migração.
AUTH_ENFORCED=true
AUTH_TOKEN_TTL=3600
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
