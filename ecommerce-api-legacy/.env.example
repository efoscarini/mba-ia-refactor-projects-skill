# Copie para .env e ajuste. Nenhum valor real deve ser versionado.
APP_ENV=development
PORT=3000
LOG_LEVEL=info

# ':memory:' recria o banco a cada boot; aponte para um arquivo para persistir
DATABASE_PATH=:memory:
SEED_ON_BOOT=true
# Senha do usuário de exemplo; vazio gera uma aleatória
SEED_USER_PASSWORD=

# Obrigatórias quando APP_ENV=production
PAYMENT_GATEWAY_KEY=
SMTP_USER=
SMTP_PASSWORD=
AUTH_SECRET=

# Autorização (RF-15). O middleware é sempre montado; esta flag decide se ele
# bloqueia. Nasce desligada para preservar o contrato das rotas originais —
# ligue para exigir Bearer token em /api/admin/financial-report e DELETE /api/users/:id.
AUTH_ENFORCED=false
AUTH_TOKEN_TTL=3600
