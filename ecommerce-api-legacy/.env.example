# Copie para .env e ajuste. Nenhum valor real deve ser versionado.
APP_ENV=development
PORT=3000
LOG_LEVEL=info

# ':memory:' recria o banco a cada boot; aponte para um arquivo para persistir
DATABASE_PATH=:memory:
SEED_ON_BOOT=true
# Senha do usuário de exemplo; vazio gera uma aleatória
SEED_USER_PASSWORD=

# Obrigatórias quando APP_ENV=production
PAYMENT_GATEWAY_KEY=
SMTP_USER=
SMTP_PASSWORD=
AUTH_SECRET=

# Autorização (RF-15). A imposição nasce LIGADA: rota sensível sem Bearer token
# responde 401. Sensíveis: GET /api/admin/financial-report e DELETE /api/users/:id
# (obtenha o token em POST /api/login). Abertas: POST /api/checkout.
# Ponha `false` só para restaurar o contrato original durante uma migração.
AUTH_ENFORCED=true
AUTH_TOKEN_TTL=3600
