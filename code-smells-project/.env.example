# Copie para .env e ajuste. Nenhum valor real deve ser versionado.
APP_ENV=development
# Obrigatória quando APP_ENV=production. Gere com: python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_PATH=loja.db
CORS_ORIGINS=*
LOG_LEVEL=INFO
# Senha do usuário admin criado na carga inicial (opcional)
SEED_ADMIN_PASSWORD=

# Autorização (RF-15). A imposição nasce LIGADA: rota sensível sem Bearer token
# responde 401 (obtenha o token em POST /login). Sensíveis: /usuarios,
# /usuarios/<id>, /relatorios/vendas, todo /pedidos e a escrita em /produtos
# (POST/PUT/DELETE). Abertas: /, /health, leitura de /produtos, POST /usuarios.
# Ponha `false` só para restaurar o contrato original durante uma migração.
AUTH_ENFORCED=true
AUTH_TOKEN_TTL=3600
